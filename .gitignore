**/.cache/
**/__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# ---------- 3b. Python packaging residue (audit CLI) ----------
/audit/build/
/audit/dist/
/audit/*.egg-info/
/audit/**/*.egg-info/

