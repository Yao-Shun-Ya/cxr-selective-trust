# ============================================================
# CXR Selective Trust — repository ignore rules
#
# Design principle: source code, protocols, configs and paper
# sources are versioned. Weights, images, datasets, generated
# outputs, virtual environments and internal working notes are
# NOT. See configs/models.lock.yaml for how to obtain weights.
# ============================================================

# ---------- 1. Model weights (never commit; see models.lock.yaml) ----------
/program/models/
/models/
*.safetensors
*.safetensors.index.json
*.bin
*.gguf
*.ggml
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.msgpack
*.npy
*.npz
*.joblib

# ---------- 2. Datasets and image material (licence-restricted / PHI-adjacent) ----------
/data/
/data/**
!/data/README.md
/program/data/*
!/program/data/manifests/
/program/data/manifests/*
!/program/data/manifests/nih_eval_1506.csv
!/program/data/manifests/nih_eval_1732.csv
!/program/data/manifests/padchest_shift.csv
!/program/data/manifests/openi_rrg.csv
!/program/data/manifests/crossmodal_mri.csv
!/program/data/manifests/crossmodal_oct.csv
!/program/data/manifests/crossmodal_derm.csv
!/program/data/manifests/MANIFEST_SHA256.json
/program/素材/
/素材/
*.dcm
*.dicom
*.nii
*.nii.gz
*.jpg
*.jpeg
*.png
*.tar
*.tar.gz
*.tgz
*.h5.gz
# but keep the paper's own figures
!papers/**/figures/*.png
!figures/**/*.png
# and keep the synthetic unit-test fixtures (fabricated ids/hashes, ~110 KB total;
# they document the manifest and prediction schemas, see docs/49)
!tests/fixtures/**
!tests/fixtures/**/*.png

# ---------- 3. Generated outputs, caches, logs ----------
/outputs/
outputs/
/program/outputs/
/program/outputs/**
/artifacts/
/artifacts/**
/checkpoints/
/logs/
/logs/**
/program/*.log
/program/error*.log
/program/memory_*.log
*.log
/program/stub_counter.json
